# ==============================================================================
# NexStock Environment Template (DO NOT COMMIT ACTUAL SECRETS)
# Copy to .env for local development only.
# ==============================================================================

NODE_ENV=development
API_HOST=0.0.0.0
API_PORT=4000

# ------------------------------------------------------------------------------
# Database Credentials (STRICT SEPARATION REQUIRED — UD-01 & Principle #5)
# ------------------------------------------------------------------------------
# 1. Runtime Application Role: MUST connect as a role with NOSUPERUSER NOBYPASSRLS.
#    The API runtime startup check will abort if connected with rolbypassrls=true!
APP_DATABASE_URL=postgresql://nexstock_app_user:SET_IN_LOCAL_ENV@localhost:5432/nexstock

# 2. Privileged Migration Role: Used ONLY by the CLI migration tool, NEVER by runtime requests.
MIGRATION_DATABASE_URL=postgresql://nexstock_migrator:SET_IN_LOCAL_ENV@localhost:5432/nexstock

# ------------------------------------------------------------------------------
# Supabase Authentication (Verified Asymmetric ES256 JWKS & Auth GoTrue)
# ------------------------------------------------------------------------------
SUPABASE_URL=https://tokylhdgzyoxiqwvncis.supabase.co
SUPABASE_JWKS_URL=https://tokylhdgzyoxiqwvncis.supabase.co/auth/v1/.well-known/jwks.json
SUPABASE_JWT_ISSUER=https://tokylhdgzyoxiqwvncis.supabase.co/auth/v1
SUPABASE_JWT_AUDIENCE=authenticated

# Supabase Anonymous / Public API Key (Required for User Registration, Login & Password Reset)
# Obtain from Supabase Dashboard > Project Settings > API > Project API Keys > `anon` / `public`.
SUPABASE_ANON_KEY=SET_IN_LOCAL_ENV
SUPABASE_PUBLISHABLE_KEY=SET_IN_LOCAL_ENV
