{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "NexStock",
  "version": "0.1.0",
  "identifier": "com.nexstock.erp",
  "build": {
    "frontendDist": "../../web/public",
    "devUrl": "http://localhost:4173"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "NexStock ERP & POS",
        "width": 1366,
        "height": 840,
        "minWidth": 360,
        "minHeight": 640,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self' 'unsafe-inline' data: blob: https:; connect-src 'self' http://localhost:* http://127.0.0.1:* https://*.onrender.com https://*.supabase.co"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all"
  }
}
